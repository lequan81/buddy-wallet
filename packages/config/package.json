{
  "name": "@repo/config",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "bunx tsc --noEmit"
  },
  "sideEffects": false,
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "bun-types": "^1.3.11",
    "eslint": "^9.0.0",
    "typescript": "^6.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./frontend": {
      "types": "./src/frontend/index.ts",
      "default": "./src/frontend/index.ts"
    },
    "./frontend/*": {
      "types": "./src/frontend/*.ts",
      "default": "./src/frontend/*.ts"
    },
    "./shared": {
      "types": "./src/shared/index.ts",
      "default": "./src/shared/index.ts"
    },
    "./shared/*": {
      "types": "./src/shared/*.ts",
      "default": "./src/shared/*.ts"
    },
    "./auth": {
      "types": "./src/auth/index.ts",
      "default": "./src/auth/index.ts"
    },
    "./auth/*": {
      "types": "./src/auth/*.ts",
      "default": "./src/auth/*.ts"
    },
    "./import": {
      "types": "./src/import/index.ts",
      "default": "./src/import/index.ts"
    },
    "./import/*": {
      "types": "./src/import/*.ts",
      "default": "./src/import/*.ts"
    },
    "./storage": {
      "types": "./src/storage/index.ts",
      "default": "./src/storage/index.ts"
    },
    "./storage/*": {
      "types": "./src/storage/*.ts",
      "default": "./src/storage/*.ts"
    },
    "./app": {
      "types": "./src/app/index.ts",
      "default": "./src/app/index.ts"
    },
    "./app/*": {
      "types": "./src/app/*.ts",
      "default": "./src/app/*.ts"
    },
    "./env": {
      "types": "./src/env/index.ts",
      "default": "./src/env/index.ts"
    },
    "./env/*": {
      "types": "./src/env/*.ts",
      "default": "./src/env/*.ts"
    }
  }
}
