{
  "name": "@repo/schema",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "bunx tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./env": {
      "types": "./src/env/index.ts",
      "default": "./src/env/index.ts"
    },
    "./dto": {
      "types": "./src/dto/index.ts",
      "default": "./src/dto/index.ts"
    },
    "./dto/*": {
      "types": "./src/dto/*/index.ts",
      "default": "./src/dto/*/index.ts"
    },
    "./adapters": {
      "types": "./src/adapters/index.ts",
      "default": "./src/adapters/index.ts"
    }
  },
  "dependencies": {
    "valibot": "^1.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "bun-types": "1.3.14",
    "eslint": "^9.0.0",
    "typescript": "^6.0.0"
  }
}
