{
  "extends": "@repo/typescript-config/library.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"],
      "@repo/ui/*": ["./src/*"]
    },
    "types": ["node", "bun-types"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
