{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "default",
  "rsc": false,
  "tsx": false,
  "tailwind": {
    "config": "tailwind.config.ts",
    "css": "layout.css",
    "baseColor": "zinc",
    "cssVariables": true,
    "prefix": ""
  },
  "aliases": {
    "components": "$lib/components",
    "utils": "$lib/utils",
    "ui": "$lib/components/ui",
    "hooks": "$lib/hooks"
  },
  "registries": {
    "@default": "https://shadcn-svelte.com/registry/{name}.json",
    "@ss-components": "https://shadcnstudio.com/r/components/{name}.json",
    "@ss-themes": "https://shadcnstudio.com/r/themes/{name}.json",
    "@ss-blocks": "https://shadcnstudio.com/r/blocks/{name}.json"
  }
}
