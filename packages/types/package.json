{
  "name": "@repo/types",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "main": "./src/index.d.ts",
  "types": "./src/index.d.ts",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.d.ts"
    },
    "./core": {
      "types": "./src/core/index.d.ts",
      "default": "./src/core/index.d.ts"
    },
    "./core/*": {
      "types": "./src/core/*.d.ts",
      "default": "./src/core/*.d.ts"
    },
    "./api": {
      "types": "./src/api/index.d.ts",
      "default": "./src/api/index.d.ts"
    },
    "./api/*": {
      "types": "./src/api/*.d.ts",
      "default": "./src/api/*.d.ts"
    },
    "./infrastructure": {
      "types": "./src/infrastructure/index.d.ts",
      "default": "./src/infrastructure/index.d.ts"
    },
    "./infrastructure/*": {
      "types": "./src/infrastructure/*.d.ts",
      "default": "./src/infrastructure/*.d.ts"
    },
    "./notifications": {
      "types": "./src/notifications/index.d.ts",
      "default": "./src/notifications/index.d.ts"
    },
    "./notifications/*": {
      "types": "./src/notifications/*.d.ts",
      "default": "./src/notifications/*.d.ts"
    },
    "./services": {
      "types": "./src/services/index.d.ts",
      "default": "./src/services/index.d.ts"
    },
    "./services/*": {
      "types": "./src/services/*.d.ts",
      "default": "./src/services/*.d.ts"
    }
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/bun": "^1.3.9",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0",
    "eslint": "^9.0.0"
  }
}
