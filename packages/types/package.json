{
  "name": "@repo/types",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "main": "./src/index.d.ts",
  "types": "./src/index.d.ts",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.d.ts"
    },
    "./shared": {
      "types": "./src/shared/index.d.ts",
      "default": "./src/shared/index.d.ts"
    },
    "./shared/*": {
      "types": "./src/shared/*.d.ts",
      "default": "./src/shared/*.d.ts"
    },
    "./api": {
      "types": "./src/api/index.d.ts",
      "default": "./src/api/index.d.ts"
    },
    "./api/*": {
      "types": "./src/api/*.d.ts",
      "default": "./src/api/*.d.ts"
    },
    "./worker": {
      "types": "./src/worker/index.d.ts",
      "default": "./src/worker/index.d.ts"
    },
    "./worker/*": {
      "types": "./src/worker/*.d.ts",
      "default": "./src/worker/*.d.ts"
    },
    "./web": {
      "types": "./src/web/index.d.ts",
      "default": "./src/web/index.d.ts"
    },
    "./web/*": {
      "types": "./src/web/*.d.ts",
      "default": "./src/web/*.d.ts"
    }
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "bun-types": "1.3.14",
    "typescript": "^6.0.0",
    "eslint": "^9.0.0"
  }
}
