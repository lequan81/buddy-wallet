{
  "name": "buddy-wallet",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:emails": "turbo run build --filter=@repo/email-templates",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check": "turbo run check check-types",
    "format": "prettier --write .",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "start": "turbo run start",
    "clean": "turbo run clean",
    "start:unified": "bun run start.ts"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.0",
    "turbo": "2.8.8"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@sinclair/typebox": "^0.34.0",
    "svelte": "^5.45.6"
  }
}
