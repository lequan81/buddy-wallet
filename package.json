{
  "name": "buddy-wallet",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@repo/web --filter=@repo/api --filter=@repo/worker --ui=tui",
    "lint": "turbo run lint",
    "check": "turbo run check check-types",
    "format": "prettier --write .",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "dev:worker": "turbo run dev --filter=@repo/worker",
    "start:worker": "turbo run start --filter=@repo/worker",
    "start": "bun run start.ts",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.0",
    "turbo": "2.9.5",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@sinclair/typebox": "^0.34.8",
    "svelte": "^5.55.3",
    "tailwindcss": "^4.1.17",
    "typescript": "^6.0.2"
  }
}
