[Unit]
Description=Buddy Wallet Import Worker
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=buddy
WorkingDirectory=/opt/buddy-wallet/apps/worker
ExecStart=/usr/local/bin/bun run start

# ── Memory Protection ──
Environment=BUN_JSC_gcMaxHeapSize=419430400
Environment=NODE_ENV=production

MemoryHigh=400M
MemoryMax=512M

Restart=on-failure
RestartSec=5
OOMPolicy=stop

# ── Security Hardening ──
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/buddy-wallet

# ── Logging ──
StandardOutput=journal
StandardError=journal
SyslogIdentifier=buddy-wallet-worker

[Install]
WantedBy=multi-user.target
