[Unit]
Description=Buddy Wallet Database Cleanup
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/bun run /opt/buddy-wallet/apps/api/scripts/cleanup/index.ts
User=buddy
WorkingDirectory=/opt/buddy-wallet
CPUSchedulingPolicy=idle
Nice=19

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/buddy-wallet

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=buddy-wallet-cleanup
