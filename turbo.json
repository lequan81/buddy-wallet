{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".env", ".env.*"],
  "globalPassThroughEnv": ["NODE_ENV", "LOG_LEVEL", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env*", "bun.lockb"],
      "outputs": [".svelte-kit/**", "dist/**", "build/**"],
      "env": ["VITE_API_URL", "VITE_WEB_URL", "PORT"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "outputLogs": "new-only",
      "passThroughEnv": ["NODE_ENV", "PORT", "VITE_API_URL", "VITE_WEB_URL"]
    },
    "lint": { "dependsOn": ["^lint"], "cache": true },
    "check": { "dependsOn": ["^check"], "cache": true },
    "check-types": { "dependsOn": ["^check-types"], "cache": true },
    "test": { "dependsOn": ["^build"], "cache": true },
    "generate": { "cache": false },
    "start": { "dependsOn": ["build"], "cache": false, "persistent": true },
    "clean": { "cache": false }
  }
}
