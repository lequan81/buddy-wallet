[Unit]
Description=Run Buddy Wallet Cleanup Daily
Requires=buddy-cleanup.service

[Timer]
# Run every 15 minutes
OnCalendar=*:0/15
# Add random delay up to 30 seconds to prevent thundering herd
RandomizedDelaySec=30
# Catch up if the system was off during scheduled time
Persistent=true

[Install]
WantedBy=timers.target
