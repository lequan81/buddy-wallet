[Unit]
Description=Run Buddy Wallet Cleanup Daily
Requires=buddy-cleanup.service

[Timer]
# Run daily at 3:00 AM
OnCalendar=*-*-* 03:00:00
# Add random delay up to 10 minutes to prevent thundering herd
RandomizedDelaySec=600
# Catch up if the system was off during scheduled time
Persistent=true

[Install]
WantedBy=timers.target
