{
  "name": "@repo/api",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test",
    "lint": "eslint .",
    "dev": "bun --env-file .env --watch src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=bun --external @repo/* --external @elysiajs/* --external @bogeychan/* --external @opentelemetry/* --external @minilibs/* --external @upyo/* --sourcemap --minify",
    "generate-types": "dts-bundle-generator --project tsconfig.types.json --no-check --silent -o dist/index.d.ts src/index.ts",
    "start": "bun run dist/index.js",
    "check-types": "bunx tsc --noEmit && bun run generate-types",
    "clean": "powershell -Command \"if (Test-Path dist) { Remove-Item -Recurse -Force dist }\""
  },
  "dependencies": {
    "@bogeychan/elysia-etag": "^0.1.0",
    "@elysiajs/bearer": "^1.4.4",
    "@elysiajs/cookie": "^0.8.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/opentelemetry": "^1.4.11",
    "@elysiajs/swagger": "^1.3.1",
    "@minilibs/ip2geo": "^0.0.6",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.211.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@repo/config": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/errors": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/schema": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/utils": "workspace:*",
    "@upyo/core": "^0.4.0",
    "@upyo/smtp": "^0.4.0",
    "bun-types": "1.3.14",
    "elysia": "^1.4.28",
    "exceljs": "^4.4.0",
    "jose": "^6.2.3",
    "valibot": "^1.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.4",
    "typescript": "^6.0.3"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./dist/index.d.ts"
    },
    "./modules/storage/services/image-processing.service": "./src/modules/storage/services/image-processing.service.ts"
  }
}
