{
  "name": "@repo/api",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test",
    "lint": "eslint .",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=bun --packages external --sourcemap --minify",
    "start": "bun run dist/index.js",
    "check-types": "bunx tsc --noEmit",
    "clean": "powershell -Command \"if (Test-Path dist) { Remove-Item -Recurse -Force dist }\"",
    "storage:migrate:s3": "bun run scripts/storage/migrate-to-s3.ts"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/email-templates": "workspace:*",
    "@repo/errors": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/permissions": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/utils": "workspace:*",
    "@repo/schemas": "workspace:*",
    "@repo/validation": "workspace:*",
    "@elysiajs/bearer": "^1.4.3",
    "@elysiajs/cookie": "^0.8.0",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/jwt": "^1.4.1",
    "@elysiajs/opentelemetry": "^1.4.10",
    "@minilibs/ip2geo": "^0.0.6",
    "@opentelemetry/core": "^2.6.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.211.0",
    "@opentelemetry/sdk-trace-base": "^2.6.0",
    "@opentelemetry/sdk-trace-node": "^2.6.0",
    "@upyo/core": "^0.4.0",
    "@upyo/smtp": "^0.4.0",
    "elysia": "^1.4.28",
    "exceljs": "^4.4.0",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@types/web-push": "^3.6.4",
    "bun-types": "^1.3.11",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  }
}
