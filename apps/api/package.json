{
  "name": "@repo/api",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test",
    "lint": "eslint .",
    "dev": "bun --env-file .env --watch src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=bun --packages external --sourcemap --minify",
    "start": "bun run dist/index.js",
    "check-types": "bunx tsc --noEmit",
    "clean": "powershell -Command \"if (Test-Path dist) { Remove-Item -Recurse -Force dist }\""
  },
  "dependencies": {
    "@bogeychan/elysia-etag": "^0.1.0",
    "@elysiajs/bearer": "^1.4.3",
    "@elysiajs/cookie": "^0.8.0",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/jwt": "^1.4.1",
    "@elysiajs/opentelemetry": "^1.4.11",
    "@minilibs/ip2geo": "^0.0.6",
    "@opentelemetry/core": "^2.6.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.211.0",
    "@opentelemetry/sdk-trace-base": "^2.6.1",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@repo/config": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/email-templates": "workspace:*",
    "@repo/errors": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/schema": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/utils": "workspace:*",
    "@repo/validation": "workspace:*",
    "@upyo/core": "^0.4.0",
    "@upyo/smtp": "^0.4.0",
    "elysia": "^1.4.28",
    "exceljs": "^4.4.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.34.5",
    "tsyringe": "^4.10.0",
    "valibot": "^1.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/web-push": "^3.6.4",
    "bun-types": "^1.3.12",
    "eslint": "^9.39.4",
    "typescript": "^6.0.2"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/index.d.ts"
    }
  }
}
