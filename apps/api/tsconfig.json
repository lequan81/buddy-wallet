{
  "extends": "@repo/typescript-config/app.json",
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@plugins": ["./src/plugins"],
      "@plugins/*": ["./src/plugins/*"],
      "@controllers": ["./src/controllers"],
      "@controllers/*": ["./src/controllers/*"],
      "@services": ["./src/services"],
      "@services/*": ["./src/services/*"],
      "@repositories": ["./src/repositories"],
      "@repositories/*": ["./src/repositories/*"],
      "@states": ["./src/states"],
      "@states/*": ["./src/states/*"],
      "@storage": ["./src/services/storage"],
      "@storage/*": ["./src/services/storage/*"],
      "@types": ["./src/types/index.d.ts"],
      "@types/*": ["./src/types/*"],
      "@utils": ["./src/utils"],
      "@utils/*": ["./src/utils/*.utils.ts", "./src/utils/*"],
      "@/utils": ["./src/utils"],
      "@/utils/*": ["./src/utils/*.utils.ts", "./src/utils/*"],
      "@/types": ["./src/types/index.d.ts"],
      "@/types/*": ["./src/types/*"]
    },
    "types": ["bun-types"],
    "noEmit": true
  },
  "include": ["src/**/*", "tests/**/*"]
}
