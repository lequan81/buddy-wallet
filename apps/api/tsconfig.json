{
  "extends": "@repo/typescript-config/app.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@infra/*": ["./src/app/Providers/Plugins/Infrastructure/*"],
      "@infra/Redis": ["./src/app/Providers/Plugins/Infrastructure/Redis/index.ts"]
    },
    "types": [
      "bun-types",
      "node"
    ],
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "src/**/*",
    "tests/**/*"
  ]
}
