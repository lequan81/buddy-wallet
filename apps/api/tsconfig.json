{
  "extends": "@repo/typescript-config/app.json",
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@plugins": ["./src/plugins"],
      "@plugins/*": ["./src/plugins/*"],
      "@controllers": ["./src/controllers"],
      "@controllers/*": ["./src/controllers/*"],
      "@services": ["./src/services"],
      "@services/*": ["./src/services/*"],
      "@utils": ["./src/utils"],
      "@utils/*": ["./src/utils/*"],
      "@/types": ["./src/types/index.d.ts"],
      "@/types/*": ["./src/types/*"]
    },
    "types": ["bun-types"],
    "noEmit": true
  },
  "include": ["src/**/*", "tests/**/*"]
}
