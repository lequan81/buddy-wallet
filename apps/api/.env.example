# ============================================
# BUDDY WALLET - ENVIRONMENT VARIABLES
# ============================================
# Copy to .env and fill in your values.
# SECURITY: Never commit .env files with real secrets to version control!

# ============================================
# APPLICATION
# ============================================

# API port (default: 3000)
PORT=3000

# Frontend URL for CORS and redirects (comma-separated for multiple origins)
WEB_URL=http://localhost:5173

# Frontend URL for password reset links (optional, falls back to WEB_URL)
FRONTEND_URL=http://localhost:5173

# ============================================
# DATABASE (SQLite)
# ============================================

# SQLite database file path (relative to packages/db/)
DATABASE_URL=../../data/buddy-wallet.sqlite

# ============================================
# REDIS
# ============================================

# Redis enabled (set false to run without Redis in dev)
REDIS_ENABLED=true

# Redis host
REDIS_HOST=localhost

# Redis port
REDIS_PORT=6379

# Redis password (empty for no auth)
REDIS_PASSWORD=

# Redis TLS (true for production, false for local dev)
REDIS_TLS=false

# ============================================
# AUTHENTICATION & JWT
# ============================================

# JWT secret key (minimum 32 characters, random)
# Generate: openssl rand -hex 32
JWT_SECRET=your-secret-key-minimum-32-characters-long-random-string

# Access token lifetime (ms). Default: 15 minutes
ACCESS_TOKEN_LIFETIME=900000

# Refresh token lifetime (ms). Default: 90 days
REFRESH_TOKEN_LIFETIME=7776000000

# JWT blacklist TTL (seconds). Default: 15 minutes
JWT_BLACKLIST_SECONDS=900

# Minimum password length
MIN_PASSWORD_LENGTH=8

# Argon2 password hashing
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3

# ============================================
# RATE LIMITING
# ============================================

# Trusted proxies for X-Forwarded-For (comma-separated)
TRUSTED_PROXIES=127.0.0.1,::1

# ============================================
# DEBT CONFIGURATION
# ============================================

DEBT_MIN_AMOUNT=1000
DEBT_MAX_AMOUNT=1000000000000

# ============================================
# IMPORT CONFIGURATION
# ============================================

IMPORT_MAX_ROWS=1000
IMPORT_STALE_LOG_LIFETIME=86400000

# ============================================
# EMAIL (Gmail SMTP via @upyo)
# ============================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NOREPLY=no-reply@yourdomain.com
SMTP_FROM_SUPPORT=support@yourdomain.com
TEST_EMAIL=test@email.com

# ============================================
# STORAGE (MinIO S3-compatible)
# ============================================

# S3 endpoint — can be a full URL (http:// or https://) or just a hostname.
# If no protocol is provided, S3_SSL controls whether https:// or http:// is used.
# Examples:
#   S3_ENDPOINT=http://localhost:9000   (local dev, explicit protocol)
#   S3_ENDPOINT=s3.example.com          (production, uses S3_SSL to determine protocol)
S3_ENDPOINT=http://localhost:9000

# S3 SSL — auto-prepend https:// when S3_ENDPOINT has no protocol (default: false)
S3_SSL=false

# MinIO region (use us-east-1 for MinIO)
S3_REGION=us-east-1

# MinIO bucket name
S3_BUCKET=buddy-wallet-files

# MinIO access key
S3_ACCESS_KEY=minioadmin

# MinIO secret key
S3_SECRET_KEY=minioadmin

# Force path-style URLs (required for MinIO)
S3_FORCE_PATH_STYLE=true

# Optional CDN/public URL base
S3_PUBLIC_BASE_URL=

# ============================================
# PUSH NOTIFICATIONS (Web Push VAPID)
# ============================================
# Generate with: bunx web-push generate-vapid-keys

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com

# ============================================
# WORKER (optional overrides)
# ============================================

# Outbox batch size (default: 25)
OUTBOX_BATCH_SIZE=25

# Worker drain timeout ms (default: 10000)
WORKER_DRAIN_TIMEOUT_MS=10000

# ============================================
# LOGGING
# ============================================

LOG_LEVEL=debug
