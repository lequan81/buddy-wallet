# Core
NODE_ENV=development
PORT=3000
JWT_SECRET=super_secure_jwt_at_least_32_characters_long
WEB_URL=http://localhost:5173

# Auth Configuration
ACCESS_TOKEN_LIFETIME=900000        # 15 minutes in ms
REFRESH_TOKEN_LIFETIME=7776000000   # 90 days in ms
JWT_BLACKLIST_SECONDS=900           # 15 minutes in seconds
MIN_PASSWORD_LENGTH=8
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3

# Debt Configuration
DEBT_MIN_AMOUNT=1000
DEBT_MAX_AMOUNT=1000000000000

# Import Configuration
IMPORT_MAX_ROWS=1000
IMPORT_STALE_LOG_LIFETIME=86400000  # 24 hours in ms
# Logging
LOG_LEVEL=debug  # debug | info | warn | error

# Redis (Upstash free tier)
REDIS_ENABLED=false
REDIS_TCP_ENABLED=true
REDIS_TCP_URL=rediss://:token@your-host.upstash.io:6379
REDIS_REST_URL=https://your-host.upstash.io
REDIS_TOKEN=your-upstash-token

# Redis Performance Tuning (optional - sensible defaults)
# REDIS_MAX_FAILURES=3           # Circuit breaker threshold
# REDIS_CIRCUIT_RESET_MS=60000   # Circuit breaker reset time (1 min)
# REDIS_DAILY_COMMAND_LIMIT=9500 # Free tier protection (10k/day limit)
# REDIS_CACHE_TTL=600            # Default cache TTL (10 min)
# REDIS_SESSION_TTL=1800         # Session cache TTL (30 min)
# REDIS_RATE_LIMIT_TTL=60        # Rate limit window (1 min)

# Trace viewer (dev only)
# TRACE_MAX_ENTRIES=100          # Max traces to store in memory

# OpenTelemetry (optional - for production monitoring)
# OTEL_SERVICE_NAME=buddy-wallet-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Axiom (optional - cloud observability)
# AXIOM_TOKEN=your-axiom-token
# AXIOM_DATASET=buddy-wallet
