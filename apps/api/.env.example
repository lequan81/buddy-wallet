# ============================================
# BUDDY WALLET - API ENVIRONMENT VARIABLES
# ============================================
# This file documents all required environment variables for the API.
# Copy to .env.local and fill in your values.
#
# SECURITY: Never commit .env files with real secrets to version control!

# ============================================
# APPLICATION
# ============================================

## Application running in production (affects security headers, HTTPS enforcement, etc)
## When false, uses development defaults (HTTP, relaxed CORS, etc)
IS_PRODUCTION=false

## API port
API_PORT=3000

## API public URL (used for CORS, redirects, etc)
API_URL=http://localhost:3000

## Frontend URL (used for CORS)
FRONTEND_URL=http://localhost:5173

## API version
API_VERSION=v1

# ============================================
# DATABASE
# ============================================

## PostgreSQL connection URL
## Format: postgresql://user:password@host:port/database?sslmode=require
## For development with Docker: postgresql://postgres:password@postgres:5432/buddy_wallet
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/buddy_wallet

## Database pool size (max simultaneous connections)
DB_POOL_SIZE=20

## Database connection timeout (milliseconds)
DB_TIMEOUT=5000

## Database SSL mode (disable, allow, prefer, require)
## Use "require" in production
DB_SSL_MODE=disable

# ============================================
# REDIS
# ============================================

## Redis URL for session and cache storage
## Format: redis://:password@host:port/db
## For development without auth: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

## Redis connection timeout (milliseconds)
REDIS_TIMEOUT=2000

## Whether Redis is required for operation
## Set to false to allow graceful degradation in development
REDIS_REQUIRED=false

# ============================================
# AUTHENTICATION & JWT
# ============================================

## JWT secret key for tokens (minimum 32 characters, random)
## Used for both access and refresh token signing
## If refresh tokens need separate key, override in code
## Generate: openssl rand -hex 32
JWT_SECRET=your-secret-key-minimum-32-characters-long-random-string

## JWT algorithm (HS256, RS256, etc)
## Default: HS256 (symmetric)
JWT_ALGORITHM=HS256

## JWT access token lifetime (milliseconds)
## Default: 15 minutes
JWT_ACCESS_TOKEN_LIFETIME=900000

## JWT refresh token lifetime (milliseconds)
## Default: 90 days
JWT_REFRESH_TOKEN_LIFETIME=7776000000

## JWT token blacklist TTL in seconds (for revocation)
## Default: 15 minutes
JWT_BLACKLIST_SECONDS=900

## Password reset token validity (milliseconds)
## Default: 6 hours - tokens expire after this period
PASSWORD_RESET_TOKEN_LIFETIME=21600000

## Password hashing algorithm (argon2id recommended)
PASSWORD_HASH_ALGORITHM=argon2id

## Argon2 memory cost (KiB)
ARGON2_MEMORY=65536

## Argon2 time cost (iterations)
ARGON2_TIME=3

## Argon2 parallelism (threads)
ARGON2_PARALLELISM=4

# ============================================
# RATE LIMITING
# ============================================

## Rate limiting backend (memory, redis)
## Use redis for production, memory for development
RATE_LIMIT_BACKEND=memory

## Rate limit window (milliseconds)
RATE_LIMIT_WINDOW=60000

## Rate limit max requests per window
RATE_LIMIT_MAX_REQUESTS=100

## Login rate limit max attempts per hour
LOGIN_RATE_LIMIT=20

## Signup rate limit max attempts per hour
SIGNUP_RATE_LIMIT=10

## Password reset rate limit max attempts per 24 hours
PASSWORD_RESET_RATE_LIMIT=5

## Email verification rate limit max attempts per hour
EMAIL_VERIFY_RATE_LIMIT=6

## OTP attempt rate limit max attempts per 10 minutes
OTP_ATTEMPT_RATE_LIMIT=5

# ============================================
# EMAIL & NOTIFICATIONS
# ============================================

## Email service provider (smtp, sendgrid, mailgun, resend)
EMAIL_PROVIDER=smtp

## SMTP host
SMTP_HOST=smtp.gmail.com

## SMTP port
SMTP_PORT=587

## SMTP secure (tls/ssl)
SMTP_SECURE=true

## SMTP username
SMTP_USER=your-email@gmail.com

## SMTP password
SMTP_PASSWORD=your-app-password

## SMTP sender email
SMTP_FROM_EMAIL=noreply@buddywallet.app

## SMTP sender name
SMTP_FROM_NAME=Buddy Wallet

## SMTP pool size
SMTP_POOL_SIZE=5

## SendGrid API key (if using SendGrid)
SENDGRID_API_KEY=your-sendgrid-key

## Mailgun API key (if using Mailgun)
MAILGUN_API_KEY=your-mailgun-key

## Mailgun domain (if using Mailgun)
MAILGUN_DOMAIN=mg.buddywallet.app

## Resend API key (if using Resend)
RESEND_API_KEY=your-resend-key

# ============================================
# STORAGE & UPLOADS
# ============================================

## File storage backend (local, s3, gcs)
FILE_STORAGE_BACKEND=local

## Local storage path
LOCAL_STORAGE_PATH=./storage/uploads

## S3 bucket name
S3_BUCKET=buddy-wallet-uploads

## S3 region
S3_REGION=us-east-1

## S3 access key
S3_ACCESS_KEY=your-aws-access-key

## S3 secret key
S3_SECRET_KEY=your-aws-secret-key

## S3 endpoint (for MinIO or compatible services)
S3_ENDPOINT=

## Maximum file upload size (bytes)
MAX_FILE_SIZE=10485760

## Allowed file extensions for import (comma-separated)
ALLOWED_IMPORT_EXTENSIONS=.xlsx,.xls,.csv

# ============================================
# THIRD-PARTY INTEGRATIONS
# ============================================

## VietQR API URL (for bank transfer QR codes)
VIETQR_API_URL=https://api.vietqr.io

# ============================================
# LOGGING
# ============================================

## Log level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=debug

## Log format (json, text)
LOG_FORMAT=text

## Log to file
LOG_TO_FILE=false

## Log file path
LOG_FILE_PATH=./logs

## Log file max size (MB)
LOG_FILE_MAX_SIZE=10

## Log file max backups
LOG_FILE_MAX_BACKUPS=5

# ============================================
# MONITORING & OBSERVABILITY
# ============================================

## Enable OpenTelemetry traces
OTEL_ENABLED=false

## OpenTelemetry exporter (jaeger, otlp, console)
OTEL_EXPORTER=console

## Jaeger endpoint
JAEGER_ENDPOINT=http://localhost:4318

## Custom metrics prefix
METRICS_PREFIX=buddy_wallet_

# ============================================
# FEATURE FLAGS
# ============================================

## Enable import/export features
FEATURE_IMPORT_EXPORT=true

## Enable email verification
FEATURE_EMAIL_VERIFICATION=true

## Enable SMS notifications
FEATURE_SMS_NOTIFICATIONS=false

## Enable WebSocket real-time updates
FEATURE_WEBSOCKET=false

## Maximum concurrent import jobs
MAX_CONCURRENT_IMPORTS=5

## Maximum rows per import file
MAX_IMPORT_ROWS=10000

# ============================================
# SESSION & SECURITY
# ============================================

## Session storage backend (memory, redis)
SESSION_BACKEND=redis

## Session lifetime (milliseconds)
SESSION_LIFETIME=86400000

## Cookie same-site policy (strict, lax, none)
COOKIE_SAME_SITE=lax

## Require HTTPS for cookies (secure flag)
COOKIE_SECURE=false

## Enable HSTS (HTTP Strict Transport Security)
HSTS_ENABLED=false

## HSTS max age (seconds)
HSTS_MAX_AGE=31536000

## CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

## Enable API key authentication
API_KEY_AUTH_ENABLED=false

# ============================================
# WORKER & JOBS
# ============================================

## Job queue backend (memory, redis, bull)
JOB_QUEUE_BACKEND=redis

## Job processing concurrency
JOB_CONCURRENCY=5

## Job timeout (milliseconds)
JOB_TIMEOUT=30000

## Job max retries
JOB_MAX_RETRIES=3

## Job retry backoff (exponential)
JOB_RETRY_BACKOFF=true

# ============================================
# SEED DATA
# ============================================

## Enable database seeding on startup
DB_SEED_ENABLED=false

## Seed data fixture files (comma-separated paths)
DB_SEED_FIXTURES=./seeds/fixtures

# ============================================
# DEVELOPMENT
# ============================================

## Enable verbose logging in development
DEBUG=buddy-wallet:*

## Enable request/response logging
REQUEST_LOGGING=true

## Enable SQL query logging
SQL_LOGGING=false

## Enable performance metrics
PERFORMANCE_METRICS=true

## Allow test endpoints (/health, /metrics, /debug)
TEST_ENDPOINTS_ENABLED=true

## API documentation endpoint
API_DOCS_ENABLED=true

## Swagger UI endpoint
SWAGGER_ENABLED=true

# ============================================
# NETWORK & PROXIES
# ============================================

## Trusted proxies for X-Forwarded-For validation (comma-separated)
## SECURITY: Only trust IPs you control (your Nginx, Docker network)
## Examples:
##   Local dev: 127.0.0.1,::1
##   Nginx on same machine: 127.0.0.1,::1
##   Nginx on different machine: 10.0.1.5,127.0.0.1
##   Docker: 172.16.0.0/12
##   Kubernetes: 10.0.0.0/8
TRUSTED_PROXIES=127.0.0.1,::1

# ============================================
# GEOLOCATION (OPTIONAL)
# ============================================

## Geolocation cache TTL (milliseconds)
GEOLOCATION_CACHE_TTL_MS=3600000

## Geo provider timeout (milliseconds)
GEO_PROVIDER_TIMEOUT_MS=2500

## Nominatim timeout for reverse geocoding (milliseconds)
NOMINATIM_TIMEOUT_MS=3000

## Circuit-breaker failure threshold
GEO_PROVIDER_FAILURE_THRESHOLD=5

## Circuit-breaker backoff duration (milliseconds)
GEO_PROVIDER_BACKOFF_MS=300000

# ============================================
# RESILIENCE & CIRCUIT-BREAKERS
# ============================================

## Email provider timeout (milliseconds)
EMAIL_PROVIDER_TIMEOUT_MS=5000

## Email provider failure threshold
EMAIL_PROVIDER_FAILURE_THRESHOLD=5

## Email provider backoff duration (milliseconds)
EMAIL_PROVIDER_BACKOFF_MS=300000

# Storage provider resilience (S3)
STORAGE_PROVIDER_TIMEOUT_MS=5000
STORAGE_PROVIDER_FAILURE_THRESHOLD=5
STORAGE_PROVIDER_BACKOFF_MS=120000

# VietQR provider resilience
VIETQR_PROVIDER_TIMEOUT_MS=5000
VIETQR_PROVIDER_FAILURE_THRESHOLD=5
VIETQR_PROVIDER_BACKOFF_MS=120000
AUTH_RECOVERY_MAX_REQUESTS=5
AUTH_RESET_MAX_REQUESTS=5
AUTH_OTP_MAX_REQUESTS=5

# Debt Configuration
DEBT_MIN_AMOUNT=1000
DEBT_MAX_AMOUNT=1000000000000

# Import Configuration
IMPORT_MAX_ROWS=1000
IMPORT_STALE_LOG_LIFETIME=86400000  # 24 hours in ms
IMPORT_CHUNK_SIZE=200
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100
PAGINATION_MAX_OFFSET=50000
DEBT_CHECK_COUNT_TOKEN=

# Storage Configuration (S3-only persistent files)
S3_ENDPOINT=https://s3.domain.com
S3_REGION=ap-southeast-1
S3_BUCKET=buddy-wallet-files
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
# Optional CDN/public URL base (if omitted, backend still serves via /v1/upload/file/:id)
S3_PUBLIC_BASE_URL=
# true for MinIO/R2 path-style endpoints, false for virtual-host style
S3_FORCE_PATH_STYLE=true

# Email (Gmail SMTP via @upyo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM_NOREPLY=no-reply@yourdomain.com
SMTP_FROM_SUPPORT=support@yourdomain.com
TEST_EMAIL=test@email.com

# Push Notifications (Web Push VAPID)
# Generate with: bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@buddywallet.app
PUSH_MAX_FAILED_ATTEMPTS=5
