{
  "name": "@repo/worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --env-file ../api/.env --watch src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=bun --packages external --sourcemap --minify",
    "start": "bun run dist/index.js",
    "clean": "powershell -Command \"if (Test-Path dist) { Remove-Item -Recurse -Force dist }\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/utils": "workspace:*",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "bun-types": "^1.3.11",
    "typescript": "^5.9.3"
  }
}
