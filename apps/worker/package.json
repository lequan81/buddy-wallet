{
  "name": "@repo/worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --env-file ../api/.env --watch src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=bun --packages external --sourcemap --minify",
    "start": "bun run dist/index.js",
    "clean": "powershell -Command \"if (Test-Path dist) { Remove-Item -Recurse -Force dist }\"",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/utils": "workspace:*",
    "exceljs": "^4.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/web-push": "^3.6.4",
    "bun-types": "1.3.11",
    "typescript": "^6.0.0"
  }
}
