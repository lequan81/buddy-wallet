	"dependencies": {
		"@repo/config": "workspace:*",
		"@repo/errors": "workspace:*",
		"@repo/types": "workspace:*",
		"@repo/utils": "workspace:*",
		"@elysiajs/eden": "^1.4.6",
		"svelte-sonner": "^1.0.7",
		"valibot": "^1.2.0"
	}
