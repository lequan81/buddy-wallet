{
	"name": "@repo/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync; svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync; svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .; eslint .",
		"format": "prettier --write .",
		"start": "bun ./build/index.js",
		"clean": "powershell -Command \"if (Test-Path build) { Remove-Item -Recurse -Force build }; if (Test-Path .svelte-kit) { Remove-Item -Recurse -Force .svelte-kit }\""
	},
	"devDependencies": {
		"@repo/api": "workspace:*",
		"@repo/eslint-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@repo/ui": "workspace:*",
		"@iconify-json/lucide": "^1.2.91",
		"@inlang/paraglide-js": "^2.6.0",
		"@internationalized/date": "^3.10.0",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.17",
		"@types/node": "^24",
		"@vite-pwa/assets-generator": "^1.0.2",
		"@vite-pwa/sveltekit": "^1.1.0",
		"bits-ui": "^2.14.4",
		"clsx": "^2.1.1",
		"elysia": "^1.4.22",
		"eslint": "^9.39.1",
		"formsnap": "^2.0.1",
		"mdsvex": "^0.12.6",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.45.6",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.3.4",
		"sveltekit-superforms": "^2.29.1",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.17",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"unplugin-auto-import": "^21.0.0",
		"unplugin-icons": "^23.0.1",
		"vite": "^7.2.6",
		"vite-plugin-pwa": "^1.2.0",
		"workbox-cacheable-response": "^7.4.0",
